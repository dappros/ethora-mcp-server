{
  "name": "@ethora/mcp-server",
  "version": "27.0.0",
  "mcpName": "io.github.dappros/ethora-mcp-server",
  "description": "MCP server for the Ethora chat & messaging platform: login, manage apps and chat rooms, broadcast messages, and deploy AI agents / chatbots with RAG sources.",
  "main": "dist/index.js",
  "type": "module",
  "access": "public",
  "bin": {
    "mcp-server": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "node ./dist/index.js",
    "dev": "ts-node ./src/index.ts",
    "build": "tsc -p tsconfig.json",
    "watch": "tsc --watch",
    "check": "tsc --noEmit --incremental",
    "format": "prettier --write .",
    "sync-version": "node scripts/sync-version.mjs",
    "prepublishOnly": "npm run build",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js",
    "test": "npm run build && node --test test/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dappros/ethora-mcp-server.git"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "remote-mcp",
    "streamable-http",
    "ethora",
    "ethora-mcp",
    "chat",
    "messaging",
    "chat-api",
    "chatbot",
    "ai-agents",
    "ai-assistant",
    "llm-tools",
    "tool-calling",
    "rag",
    "customer-support",
    "chat-widget",
    "oauth2",
    "claude",
    "chatgpt",
    "cursor",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "bugs": {
    "url": "https://github.com/dappros/ethora-mcp-server/issues"
  },
  "homepage": "https://github.com/dappros/ethora-mcp-server#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.16.0",
    "axios": "^1.11.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.2.0",
    "typescript": "^5.8.3"
  }
}
